# ── Stylist chat (any one is enough; all have free tiers). Tried in LLM_CHAIN order with fallback.
GEMINI_API_KEY=            # https://aistudio.google.com/apikey
# GEMINI_MODEL=gemini-3.5-flash,gemini-2.5-flash
GROQ_API_KEY=              # https://console.groq.com/keys
# GROQ_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b
OPENROUTER_API_KEY=        # https://openrouter.ai/keys — set OPENROUTER_MODEL to a model id ending in :free
# OPENROUTER_MODEL=
# OLLAMA_ENABLED=1         # fully local & private, e.g. `ollama pull qwen3:8b`
# OLLAMA_MODEL=qwen3:8b
# LLM_CHAIN=gemini,groq,openrouter,ollama

# ── Analysis engine
# TEINTE_DEMO=1            # UI development without the 12 backbones (results are clearly labelled demo)
# TEINTE_FUSE_S4=1.0       # 12-season × 4-season coherence weight (chosen by evaluate_fusion.py)
# TEINTE_FUSE_UT=0.5       # 12-season × undertone coherence weight
# HF_HOME=/data/hf-cache   # where timm downloads the ~8.4 GB of backbone weights on first start
# CORS_ORIGINS=https://your-domain.com
